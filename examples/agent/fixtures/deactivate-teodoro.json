{
  "scenario": "deactivate-teodoro",
  "description": "Resolves the customer by name with getCustomer and deactivates by the returned id, with no step-by-step in the request.",
  "turns": [
    {
      "match": "deactivate customer teodoro",
      "steps": [
        { "toolCalls": [ { "name": "getCustomer", "args": { "name": "teodoro" } } ] },
        { "toolCalls": [ { "name": "deactivateCustomer", "args": { "id": "{{tool:getCustomer.customer.id}}" } } ] },
        { "final": "Customer {{tool:deactivateCustomer.customer.name}} (id {{tool:deactivateCustomer.customer.id}}) is now {{tool:deactivateCustomer.customer.status}}." }
      ]
    }
  ]
}
