# Copy to .env (never commit it). npm run api, tokens, mcp and agent:demo load it when present.
# Empty values fall back to the default shown in the comment.

# --- Legacy API (npm run api) and token CLI ---
# Port of the API (1-65535)
PORT=9999
# Address the API listens on
HOST=127.0.0.1
# SQLite file; the token CLI reads the same file
DATABASE_PATH=./data/legacy.db
# Requests per token per window
RATE_LIMIT_PER_TOKEN=90
# Requests per IP per window (counted before authentication)
RATE_LIMIT_PER_IP=180
# Window length in ms (>= 1000)
RATE_LIMIT_WINDOW_MS=60000
# debug, info, warn or error (shared by API and MCP; fatal is always written)
LOG_LEVEL=info

# --- MCP server (npm run -s mcp; MCP clients start node src/mcp/main.ts directly) ---
# Required: issue one with npm run tokens -- issue --name <name> --role member|admin
SERVICE_TOKEN=
# Base URL of the legacy API
LEGACY_API_URL=http://127.0.0.1:9999
# Timeout per HTTP attempt in ms (500-30000)
LEGACY_API_TIMEOUT_MS=5000

# --- Example agent (npm run agent:demo, npm run test:live) ---
# fake or openrouter. Empty: fake, or openrouter when OPENROUTER_API_KEY is set
LLM_PROVIDER=
# OpenRouter key; leave empty to use the scripted fake
OPENROUTER_API_KEY=
# Model on OpenRouter (pick a free model with tool support if the default lacks it)
OPENROUTER_MODEL=openrouter/free
